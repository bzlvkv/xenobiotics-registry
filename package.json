{
  "name": "xenobiotics-registry",
  "private": true,
  "version": "2.0.0",
  "description": "A cited registry of compounds, pathways and receptors, with the gates that keep it honest",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @xeno/web dev",
    "build": "pnpm --filter @xeno/web build",
    "preview": "pnpm --filter @xeno/web preview",
    "validate": "tsx scripts/validate.ts",
    "verify": "tsx scripts/verify-citations.ts",
    "report": "tsx scripts/report.ts",
    "receptors:fetch": "tsx scripts/fetch-receptors.ts",
    "test": "pnpm -r test",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm validate",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "globals": "14.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.60.1",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
