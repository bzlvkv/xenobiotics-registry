{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@xeno/core": ["packages/core/src/index.ts"],
      "@xeno/core/*": ["packages/core/src/*"],
      "@xeno/registry": ["packages/registry/src/index.ts"],
      "@xeno/solver": ["packages/solver/src/index.ts"]
    },
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["scripts/authoring/**"]
}
