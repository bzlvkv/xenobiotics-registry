# Only needed for the DATABASE paths. Every gate in this project reads the JSON
# under packages/registry/data/ by default, so lint, verify and bundle all work
# with none of this set.
#
#   registry:lint   --from-db   lint the live catalog instead of the JSON
#   registry:seed   --write     import the JSON into registry.* (service role)
#   registry:push               upload a built bundle + upsert its manifest row
#   registry:curator            grant the first curator (service role)

SUPABASE_URL=https://<project-ref>.supabase.co

# Anon is enough to READ: the registry.* tables are world-readable by design.
SUPABASE_ANON_KEY=

# Bypasses RLS. Needed only to seed a fresh project or grant the first curator,
# because neither can be done by a curator who does not exist yet. Keep it out
# of any client and out of git.
SUPABASE_SERVICE_ROLE_KEY=
