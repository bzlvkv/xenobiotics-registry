# Copy to .env and fill in. `.env` is gitignored; this file is the documented shape.
#
# Nothing here is required to run the gates. Every key below raises a rate limit or
# unlocks a full-text endpoint for an authoring session; the sources themselves are all
# public. The rules in authoring/HYGIENE.md do not change with a key: a value is stored
# only if the fetched abstract or label states it verbatim for the named compound.
#
# Where each key comes from is in authoring/NETWORK.md, beside the domain it is for.
# As of 2026-09-26 no script reads any of these yet. NCBI_API_KEY is the first one worth
# wiring in (packages/registry/src/pubmed.ts and scripts/verify-citations.ts).

# ---- Literature: NCBI E-utilities (PubMed, PMC, PubChem) ----
# Free, from a My NCBI account. 3 req/s without, 10 req/s with.
NCBI_API_KEY=
# NCBI asks each tool to identify itself on every E-utilities call.
NCBI_TOOL=xenobiotics-registry
NCBI_EMAIL=

# ---- Open-access discovery ----
# Unpaywall and OpenAlex need no key, only a contact email, which moves requests to
# the faster "polite pool". Crossref reads the same email from the User-Agent.
UNPAYWALL_EMAIL=
OPENALEX_EMAIL=
CROSSREF_EMAIL=
# Semantic Scholar: free key, dedicated rate limit and full-text link fields.
SEMANTIC_SCHOLAR_API_KEY=
# CORE (core.ac.uk): free key, required for the API.
CORE_API_KEY=
# Springer Nature: free key, full-text XML for Springer open-access articles.
SPRINGER_NATURE_API_KEY=
# Elsevier / ScienceDirect: free key, abstracts and metadata only without an institution.
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=

# ---- Regulatory labels ----
# openFDA: free key, 1,000 -> 120,000 requests per day.
OPENFDA_API_KEY=

# ---- Identity, affinity, pathways ----
# DrugBank academic licence: free for non-commercial use, application required.
# Not a citable source here; used only to find which primary paper states a value.
DRUGBANK_API_KEY=
# PharmGKB: the REST API is open; an account is needed only for bulk downloads.
PHARMGKB_API_KEY=

# ---- Nutrition and supplements ----
# USDA FoodData Central: free key, required (DEMO_KEY is throttled to 30 req/h).
USDA_FDC_API_KEY=
